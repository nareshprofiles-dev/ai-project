# Copy this file to .env and adjust values as needed.

# ─── Whisper ASR Model ────────────────────────────────────────────────────────
WHISPER_DEFAULT_MODEL=large-v3
WHISPER_FALLBACK_MODEL=large-v3
WHISPER_LANGUAGE=te

# ─── Whisper Inference Parameters ─────────────────────────────────────────────
# Set WHISPER_FP16=true on a CUDA GPU for faster inference.
WHISPER_FP16=false
WHISPER_TEMPERATURE=0.0
# Leave WHISPER_BEAM_SIZE and WHISPER_BEST_OF blank to use Whisper's defaults.
WHISPER_BEAM_SIZE=
WHISPER_BEST_OF=
WHISPER_COMPRESSION_RATIO_THRESHOLD=1.8
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_NO_SPEECH_THRESHOLD=0.3

# ─── Translation Backend ───────────────────────────────────────────────────────
# Supported values: whisper
# Future values:    indictrans2 | nllb | seamlessm4t
TRANSLATION_BACKEND=whisper

# ─── Paths ────────────────────────────────────────────────────────────────────
DEFAULT_OUTPUT_DIR=output
CACHE_DIRNAME=cache
